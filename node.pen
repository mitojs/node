                {
                  "type": "text",
                  "id": "bXnrF",
                  "name": "Prompt User",
                  "fill": "$accent-green",
                  "content": "prod-01",
                  "fontFamily": "$font-data",
                  "fontSize": 12,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "gvR1W",
                  "name": "Prompt Path",
                  "fill": "$accent-cyan",
                  "content": "~/services/api",
