                {
                  "type": "text",
                  "id": "ZNZsG",
                  "name": "Prompt Command",
                  "fill": "$foreground-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "$ termpulse watch --profile prod --interval 250ms",
                  "fontFamily": "$font-data",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "h3IHOC",
                  "name": "Prompt Status",
