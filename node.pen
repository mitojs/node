{
  "version": "2.13",
  "children": [
    {
      "type": "frame",
      "id": "unaop",
      "x": 0,
      "y": 0,
      "name": "Terminal Monitor App",
      "clip": true,
      "width": 800,
      "height": 600,
      "fill": "$surface-terminal",
      "layout": "vertical",
      "gap": 10,
      "padding": 18,
      "children": [
        {
          "type": "frame",
          "id": "UBJ4f",
          "name": "Terminal Native TUI",
          "clip": true,
          "width": "fill_container",
          "height": "fill_container",
          "fill": "#030507",
          "cornerRadius": 8,
          "stroke": "$border-subtle",
          "strokeWidth": 1,
          "effect": {
            "type": "shadow",
            "shadowType": "outer",
            "color": "#000000B3",
            "offset": {
              "x": 0,
              "y": 12
            },
            "blur": 24
          },
          "layout": "vertical",
          "gap": 8,
          "padding": 14,
          "children": [
            {
              "type": "frame",
              "id": "k3yg3",
              "name": "Shell Command Row",
              "width": "fill_container",
              "height": 18,
              "gap": 8,
