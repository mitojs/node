{
	"name": "mono",
	"version": "0.0.1",
	"private": true,
	"description": "the best monorepo",
	"workspaces": [
		"packages/*",
		"utils/*",
		"app/*"
	],
	"scripts": {
		"commit": "git add . && git czg",
		"build:rust": "cd ./agent && ./build.sh",
		"build": "pnpm run build:ts && pnpm run build:rust",
		"test": "pnpm run test:packaging && pnpm -r --if-present run test",
		"web:dev": "pnpm --filter @mono/react-19 dev",
		"watch:cli": "pnpm --filter @mitojs/node-cli vite-build:esm -- --watch",
		"clean": "shx rm -rf packages/**/*.tsbuildinfo && shx rm -rf ./{packages,app}/*/{esm,dist}",
		"clean:node_module": "rm -rf ./node_modules && rm -rf ./{packages,app,e2e}/**/node_modules",
		"postinstall": "husky",
		"preinstall": "npx only-allow pnpm",
		"esm": "pnpm run build:ts",
		"build:ts": "pnpm --filter @mitojs/node-shared build && pnpm --filter @mitojs/node esm && pnpm --filter @mitojs/node-cli build",
		"build:native": "pnpm run build:rust",
		"build:rust:check": "cd agent && cargo check --locked",
		"test:e2e": "pnpm run build && pnpm --filter @mitojs/node-cli exec vitest run --config vitest.e2e.config.ts",
		"test:coverage": "pnpm -r --if-present run test:coverage",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "pnpm run lint && pnpm test && pnpm run build:ts && pnpm run build:rust:check",
		"test:packaging": "node --test scripts/tests/release-binaries.test.mjs scripts/tests/fresh-build.test.mjs scripts/benchmark-sdk.spec.cjs",
		"test:package": "pnpm run build && pnpm run pack:local",
		"pack:local": "node scripts/package-smoke.mjs"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0",
		"pnpm": ">=10 <11"
	},
	"author": "cjinhuo",
	"devDependencies": {
		"@biomejs/biome": "^2.0.6",
		"@changesets/cli": "^2.29.5",
		"@commitlint/config-conventional": "^19.2.2",
		"@mono/tsconfig": "workspace:^",
		"@types/debug": "^4.1.12",
		"@types/jest": "^29.5.12",
		"@types/node": "^22.15.30",
		"@vitest/coverage-v8": "4.1.8",
		"chalk": "^5.3.0",
		"consola": "^3.2.3",
		"czg": "^1.12.0",
		"debug": "^4.3.6",
		"fast-glob": "^3.3.2",
		"husky": "^9.1.7",
		"ink-testing-library": "4.0.0",
		"jest": "^29.7.0",
		"lint-staged": "^15.2.8",
		"npm-run-all": "^4.1.5",
		"nx": "^21.2.1",
		"shx": "^0.4.0",
		"ts-jest": "^29.2.4",
		"tslib": "^2.6.3",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"cac": "^6.7.14",
		"execa": "^6.1.0",
		"minimist": "^1.2.8"
	},
	"packageManager": "pnpm@10.33.0"
}
