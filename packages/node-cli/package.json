{
	"name": "@mitojs/node-cli",
	"version": "0.0.1",
	"description": "@mitojs/node-cli",
	"author": "cjinhuo",
	"license": "MIT",
	"bin": {
		"mito-node": "dist/cli.mjs"
	},
	"main": "dist/index.cjs",
	"module": "dist/index.esm.js",
	"type": "module",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.esm.js",
			"require": "./dist/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "run-s vite-build:esm vite-build:cjs vite-build:bin vite-build:interactive",
		"watch": "node ../../scripts/build-cli.mjs bin --watch",
		"vite-build:esm": "node ../../scripts/build-cli.mjs esm",
		"vite-build:cjs": "node ../../scripts/build-cli.mjs cjs",
		"vite-build:bin": "node ../../scripts/build-cli.mjs bin",
		"vite-build:interactive": "node ../../scripts/build-cli.mjs interactive",
		"lint": "biome check src",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@mitojs/node-shared": "workspace:*",
		"commander": "^14.0.0",
		"ink": "6.0.1",
		"react": "19.1.0",
		"string-width": "8.3.0",
		"uuid": "^11.1.0",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"@mono/tsconfig": "workspace:*",
		"@types/ws": "^8.18.1",
		"vite": "^8.0.0",
		"vite-plugin-dts": "^4.0.0",
		"vitest": "^4.1.8",
		"@types/react": "19.0.8"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}
