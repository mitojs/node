{
	"name": "@mitojs/node-cli",
	"version": "0.0.1",
	"description": "@mitojs/node-cli",
	"author": "cjinhuo",
	"license": "MIT",
	"bin": {
		"mito-node": "dist/cli.mjs"
	},
	"main": "dist/index.cjs",
	"module": "dist/index.esm.js",
	"type": "module",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.esm.js",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"publishConfig": {
		"main": "dist/index.cjs",
		"module": "dist/index.esm.js",
		"types": "dist/index.d.ts"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "run-s vite-build:esm vite-build:cjs vite-build:bin",
		"watch": "BUILD_TARGET=bin vite build --watch",
		"vite-build:esm": "BUILD_TARGET=esm vite build",
		"vite-build:cjs": "BUILD_TARGET=cjs vite build",
		"vite-build:bin": "BUILD_TARGET=bin vite build",
		"lint": "eslint ./src/**",
		"test": "vitest run"
	},
	"dependencies": {
		"@types/ink": "2.0.3",
		"@types/react": "19.0.8",
		"commander": "^14.0.0",
		"ink": "6.0.1",
		"react": "19.1.0",
		"uuid": "^11.1.0",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"@mono/tsconfig": "workspace:*",
		"@types/ws": "^8.18.1",
		"vite": "^8.0.0",
		"vite-plugin-dts": "^4.0.0",
		"vitest": "^4.1.8"
	}
}
