{
	"name": "@mitojs/node",
	"version": "0.0.1",
	"description": "@mitojs/node",
	"author": "cjinhuo",
	"license": "MIT",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"publishConfig": {
		"access": "public",
		"executableFiles": [
			"binaries/mitojs-agent-darwin-arm64",
			"binaries/mitojs-agent-darwin-x64",
			"binaries/mitojs-agent-linux-x64-musl",
			"binaries/mitojs-agent-linux-arm64-musl",
			"binaries/mitojs-agent-win-x64.exe"
		]
	},
	"files": [
		"dist",
		"binaries/mitojs-agent-darwin-arm64",
		"binaries/mitojs-agent-darwin-x64",
		"binaries/mitojs-agent-linux-x64-musl",
		"binaries/mitojs-agent-linux-arm64-musl",
		"binaries/mitojs-agent-win-x64.exe",
		"binaries/manifest.json"
	],
	"scripts": {
		"esm": "node ../../scripts/build-tsc.mjs .",
		"watch:esm": "tsc -b ./tsconfig.json --watch",
		"test": "vitest run",
		"build:rust": "cd ../../agent && ./build.sh",
		"build": "npm run esm",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@mono/tsconfig": "workspace:*",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@mitojs/node-shared": "workspace:*",
		"deepmerge": "^4.3.1",
		"rxjs": "^7.8.2"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		}
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}
