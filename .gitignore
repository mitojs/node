# Dependencies and package-manager caches
node_modules/
.pnpm-store/

# Build outputs and task caches
dist/
esm/
lib/
target/
.nx/
*.tsbuildinfo
_docpress/
analyzer.html

# Test and coverage outputs
coverage/
.nyc_output/

# Local development and editor state
.DS_Store
.idea/
# Keep only the shared editor build, debug and formatting configuration.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.codex/
.claude/settings.local.json
.cache/
.tmp/
/tmp/
temp/
.planning/
.trae/
.trae.planning/
__pycache__/
*.py[cod]

# Local environment files; keep shareable templates
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample

# Runtime logs and diagnostic artifacts
*.log
logs/
*.pid
*.pid.lock
*.cpuprofile
*.heapprofile
*.heapsnapshot
*.cast
*.tgz
report.[0-9]*.json
# TUI reports saved in the repository root use UUID filenames.
/????????-????-????-????-????????????.json
/diagnostics/
/diagnosis/
/release-packages/
/.mito-node/
/recordings/
# Rust builds replace release binaries atomically; interrupted copies are local.
/packages/node/binaries/*.tmp.*

# Raw local validation evidence and machine-specific reports.
# Keep reusable documentation and curated screenshots in docs/ instead.
/docs/reports/
